# Configuration n8n pour le formulaire de contact
# Copiez ce fichier en .env et remplissez les valeurs

# URL du webhook n8n
N8N_WEBHOOK_URL=https://n8n.digital-pragma.fr/webhook/VOTRE_ID

# Token d'authentification n8n (optionnel)
# Si vous configurez l'authentification dans n8n, mettez le token ici
N8N_AUTH_TOKEN=
